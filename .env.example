## ---------------------------------------------------------------------------
## MNScr — motor editorial de drafts
## MNScr NÃO publica, NÃO aprova e NÃO indexa. Ele gera drafts estruturados.
## ---------------------------------------------------------------------------

## Saída editorial
# Modos aceitos: local | payload
# "wordpress" é rejeitado no startup.
MNSCR_OUTPUT_MODE=local
MNSCR_LOCAL_DRAFT_DIR=artifacts/local-drafts

## Contrato de entrada (RSS Prime)
# Contrato canônico: rss-prime-event-v1
#
# TEMPORÁRIO: aceita o superfeed antigo (legacy-feed-input-v0) por um adaptador
# de compatibilidade. Será removido quando o RSS Prime emitir o contrato v1.
# Com false, itens sem contrato declarado são rejeitados (LEGACY_CONTRACT_DISABLED).
MNSCR_ACCEPT_LEGACY_FEED=true
# Vazio: aceita v1 e, temporariamente, o legado conforme a flag acima.
# rss-prime-event-v1: rejeita o contrato legado.
MNSCR_REQUIRED_INPUT_CONTRACT=
# Guarda o payload bruto recebido, para permitir replay fiel.
MNSCR_STORE_RAW_EVENT_PAYLOAD=true
# Teto de tamanho por evento, validado antes de persistir.
MNSCR_MAX_EVENT_PAYLOAD_BYTES=1048576

## Editorial Gate
# Classificador técnico e versionado do draft: GATE_CLEAR, GATE_REVIEW_REQUIRED
# ou GATE_BLOCKED. Não aprova e não publica — autoridade editorial é humana.
#
# Desabilitar é permitido apenas em desenvolvimento: o gate desligado registra
# GATE_DISABLED, que nunca habilita submissão externa nem publicação.
MNSCR_EDITORIAL_GATE_ENABLED=true
# Política inexistente falha no startup, sem fallback silencioso.
MNSCR_EDITORIAL_GATE_POLICY=mnscr-editorial-gate-v1
MNSCR_EDITORIAL_GATE_POLICY_DIR=config/editorial_gate

## Avaliação factual (claims, evidências, conflitos, cobertura)
# Estrutura o que o draft afirma e o que as fontes recebidas sustentam.
# Não resolve conflito, não verifica em fontes externas e não publica.
MNSCR_FACTUAL_ASSESSMENT_ENABLED=true
MNSCR_FACTUAL_ASSESSMENT_VERSION=mnscr-factual-assessment-v1
# deterministic = só padrões (sem IA) | hybrid = padrões + camada semântica validada
MNSCR_FACTUAL_ASSESSMENT_MODE=hybrid
MNSCR_FACTUAL_PROMPT_VERSION=factual-claim-extraction-v1
# Prompt inexistente falha no STARTUP, como a política do gate. Sem essa
# checagem, `hybrid` rodava com prompt ausente produzindo zero claims a cada
# artigo, e o log não distinguia isso de um artigo que não tinha fatos.
MNSCR_FACTUAL_PROMPT_DIR=config/prompts
MNSCR_MAX_CLAIMS_PER_DRAFT=100
MNSCR_MAX_EVIDENCE_PER_CLAIM=10
# Evidência é ponteiro para a fonte, nunca cópia dela.
MNSCR_MAX_EVIDENCE_EXCERPT_CHARS=500
MNSCR_MIN_FACTUAL_COVERAGE_RATIO=0.75

## Protocolo de categorias (3 níveis) — TUDO É PROPOSTA
# nível 1  -> contentType do contrato: enum FECHADO
#            (news, feature, review, guide, list, interview, evergreen)
# nível 2  -> seo.articleSectionSuggestion: Cinema | Séries
# nível 3  -> entityLinks[], só para entidades com entityId já existente no CMS
#
# O MNScr NÃO cria taxonomia. A service account só pode ter os escopos
# draft_ingest, publication_projection e editorial_auto_publish — nenhum deles
# cria categoria, seção ou entidade.
MNSCR_TAXONOMY_PROMPT_VERSION=taxonomy-classification-v1
MNSCR_MAX_ENTITIES_PER_DRAFT=12

## Validação de mídia
# O MNScr nunca baixa bytes: seguir URL de página de terceiro com a credencial
# do processo é SSRF. Valida a FORMA do candidato e exige uma única capa.
MNSCR_REQUIRE_HERO_IMAGE=true
MNSCR_MIN_HERO_EDGE_PX=600

## ---------------------------------------------------------------------------
## Publicação no Cinerie CMS — contrato editorial-publication-request-v1
##
## Repositório do CMS: maquinanerd/screena
## Especificação:      docs/contracts/mnscr-autopublication-delivery.md
##
## DESLIGADO por padrão. O contrato manda, no item 9.2, publicar contra o CMS
## de CANÁRIO antes de produção.
## ---------------------------------------------------------------------------
CINERIE_PUBLICATION_ENABLED=false
CINERIE_BASE_URL=
# API key da service account: escopo `editorial_auto_publish` e SOMENTE ele.
CINERIE_API_KEY=
CINERIE_PUBLICATION_ENDPOINT=/api/internal/editorial-publications
# O schemaHash vem daqui a cada execução. NÃO fixe um literal no código:
# hash desatualizado transforma toda publicação em 422 BLOCKED.
CINERIE_CONTRACTS_ENDPOINT=/api/internal/contracts
# Autor PÚBLICO que assina. Precisa existir no CMS e ter declarado que aceita
# publicação automática para o tipo de conteúdo enviado.
CINERIE_PUBLIC_AUTHOR_ID=
# byline | newsroom | assisted
CINERIE_ATTRIBUTION_MODE=assisted
CINERIE_TIMEOUT_SECONDS=20
CINERIE_MAX_ATTEMPTS=3
CINERIE_RETRY_BASE_SECONDS=2

## Entrega ao Payload CMS (MS-5)
# O Payload CMS vive no repositório Screen-App, não no MNScr. Esta integração
# foi implementada e testada apenas contra um servidor local falso; ela não foi
# validada contra uma instância real. Ver docs/ms5-screen-app.md.
#
# Desabilitada por padrão. O MNScr cria apenas drafts para revisão humana.
PAYLOAD_CMS_ENABLED=false
PAYLOAD_CMS_BASE_URL=
# Opcional: sobrescreve o endpoint derivado de BASE_URL + COLLECTION.
PAYLOAD_CMS_DRAFT_ENDPOINT=
# Nunca commite um token real.
PAYLOAD_CMS_TOKEN=
PAYLOAD_CMS_COLLECTION=editorial-drafts
PAYLOAD_CMS_TIMEOUT_SECONDS=15
PAYLOAD_CMS_MAX_ATTEMPTS=3
PAYLOAD_CMS_RETRY_BASE_SECONDS=2

## Cinerie — publicação governada (editorial-publication-request-v1)
#
# Canal SEPARADO do envio de rascunho acima: outro contrato, outro endpoint,
# outro escopo. Dois caminhos e duas semânticas — transformar o endpoint de
# rascunho num endpoint de publicação faria um pipeline que só sabia propor
# passar a publicar sem mudar uma linha.
#
# DRAFT       usa o contrato e o endpoint de rascunho; não pede publicação.
# AUTO_PUBLISH usa editorial-publication-request-v1; exige preflight contratual,
#             QA aprovado e autor público configurado.
#
# Em produção este valor é OBRIGATÓRIO: um default do código decidiria sozinho
# se a matéria sai publicada ou como rascunho.
MNSCR_DELIVERY_MODE=DRAFT
MNSCR_ENVIRONMENT=development

# Apenas a ORIGEM do serviço interno — nunca um endpoint, nunca com credencial
# embutida (ela vazaria em qualquer log que registre a URL).
PAYLOAD_INTERNAL_SERVICE_URL=
# API key da service account, escopo `editorial_auto_publish` e SÓ ele.
# Nunca commite uma chave real. Não use conta pessoal, usuário administrativo,
# credencial do WordPress nem a credencial do worker de projeção.
MNSCR_PAYLOAD_API_KEY=

# Autor PÚBLICO que assina a matéria — o id de uma entidade `Author` já
# autorizada no Cinerie, nunca um nome livre. O ator TÉCNICO não vem daqui: ele
# é derivado da credencial autenticada, do lado do Cinerie.
#
# É o id NUMÉRICO da linha (ex.: 12), não o slug do autor: o runtime do Cinerie
# testa `/^\d+$/` antes de procurar, e um slug reprova toda matéria com
# `author_not_found`. Peça o número à redação; ele aparece na URL do documento
# no painel do CMS.
MNSCR_PUBLIC_AUTHOR_ID=
# byline | newsroom | assisted. A política do próprio autor decide o que ele aceita.
MNSCR_ATTRIBUTION_MODE=newsroom

MNSCR_CONTRACT_PREFLIGHT_TTL_SECONDS=300
MNSCR_CINERIE_TIMEOUT_SECONDS=20
MNSCR_CINERIE_MAX_ATTEMPTS=3
MNSCR_CINERIE_RETRY_BASE_SECONDS=2

# Ingestao de midia editorial (`/api/internal/editorial-media`) — rota
# SEPARADA da publicacao de texto, com credencial SEPARADA de proposito: o
# Cinerie exige uma conta tecnica com o escopo `editorial_media_ingest`, e so
# ele. Nunca reaproveite MNSCR_PAYLOAD_API_KEY aqui.
#
# LIGADO por decisao do dono do produto: a foto sobe, ganha mediaId e
# proveniencia e fica na biblioteca do Cinerie. Quem escolhe a CAPA continua
# sendo um humano no painel — a rota que aponta capa automaticamente sera feita
# no repo do Cinerie, nao aqui (ver docs/operations/editorial-media-ingest.md).
#
# Falha de imagem NUNCA derruba materia: erro vira WARNING e a publicacao segue
# sem foto. A garantia esta em dois lugares independentes (`ingest_hero_image` e
# `_ingest_hero_media_best_effort`) porque a posicao da chamada e dentro do
# `try` que trata falha de publicacao — uma excecao vazando dali seria lida como
# "a publicacao falhou" DEPOIS de o Cinerie ja ter aceitado a materia.
MNSCR_CINERIE_MEDIA_UPLOAD_ENABLED=true
MNSCR_CINERIE_MEDIA_API_KEY=

## Payload CMS (submitter da MS-1) — integração ainda bloqueada pelo contrato editorial
PAYLOAD_ENABLED=false
PAYLOAD_BASE_URL=
PAYLOAD_API_TOKEN=
PAYLOAD_DRAFTS_COLLECTION=editorial-drafts

## Identidade editorial
PUBLISHER_NAME=Cinerie
# Domínio usado apenas para sugerir links internos no corpo do draft.
PUBLISHER_DOMAIN=

# Domínios que são NOSSOS, separados por vírgula. A guarda de markup de CMS usa
# esta lista para separar vazamento do NOSSO legado de dado da FONTE: uma URL
# `/wp-content/uploads/` bloqueia quando o host está aqui, e passa quando é de
# terceiro. ScreenRant, ComicBook e MovieWeb também são WordPress e servem
# imagem por esse caminho — sem a lista, a guarda mata a matéria pela fonte.
#
# Preencha com o domínio do nosso WordPress legado. Ele não tem valor padrão e
# não aparece no código: o repositório proíbe citar o domínio legado em app/ e
# tests/ (TestSecurity), e este arquivo é o lugar certo para ele.
#
# PUBLISHER_DOMAIN é somado automaticamente. Subdomínios contam.
# VAZIO DESLIGA A GUARDA: o vazamento do nosso legado passa sem bloqueio. O
# startup registra um aviso quando isso acontece.
MNSCR_OWN_CMS_DOMAINS=
MNSCR_USER_AGENT=MNScr/1.0 (+editorial draft pipeline)
MNSCR_PROMPT_VERSION=universal_prompt-ms1

## Gemini API keys (uma ou mais). Valores devem começar com AIza...
GEMINI_KEY_1=
GEMINI_KEY_2=

## Seleção de modelo
GEMINI_MODEL_ID=gemini-3.1-flash-lite
AI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
AI_MAX_RETRIES=8

## AI Validator (segunda camada de IA)
AI_VALIDATOR_ENABLED=true
AI_VALIDATOR_MODEL=gemini-2.5-flash-lite
AI_VALIDATOR_MAX_RETRIES=1
AI_VALIDATOR_FAIL_OPEN=true

## Orçamento de tokens por artigo
AI_POST_WRITER_BUDGET_TOKENS=16000
AI_POST_WRITER_BUDGET_PER_1K_SOURCE=6000

## AI backoff / rate limits
AI_MIN_INTERVAL_S=6
BACKOFF_BASE_S=20
BACKOFF_MAX_S=300

## Agendador / pipeline
CHECK_INTERVAL_MINUTES=15
MAX_PER_FEED_CYCLE=3
MAX_PER_CYCLE=10
ARTICLE_SLEEP_S=120
BETWEEN_BATCH_DELAY_S=30
BETWEEN_PUBLISH_DELAY_S=30
FEED_STAGGER_S=45
ARTICLE_WATCHDOG_TIMEOUT_S=300
MAX_ARTICLE_FAIL_COUNT=5

## Política de fonte
# true permite gerar draft a partir de uma única fonte não-allowlisted.
ALLOW_SINGLE_SOURCE=false
