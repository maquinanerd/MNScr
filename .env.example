## Gemini API keys (one or more). Values must start with AIza...
GEMINI_KEY_1=
GEMINI_KEY_2=

## Gemini model selection
GEMINI_MODEL_ID=gemini-3.1-flash-lite
AI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
AI_MAX_RETRIES=8

## WordPress credentials
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_PASSWORD=

## Dashboard / logging
SECRET_KEY=
LOG_LEVEL=INFO

## Scheduler
CHECK_INTERVAL_MINUTES=15
MAX_ARTICLES_PER_FEED=3
PER_ARTICLE_DELAY_SECONDS=8
PER_FEED_DELAY_SECONDS=15
CLEANUP_AFTER_HOURS=72

## Indexador instantaneo
INDEXER_INTERVAL_MINUTES=5
INDEXER_POST_LIMIT=20
INDEXER_TIMEOUT=20
INDEXER_DB_PATH=data/indexing.db
INDEXER_NOTIFY_ON_PUBLISH=false
INDEXER_NOTIFY_PROCESS_IMMEDIATELY=true
WORDPRESS_SITE_URL=
WORDPRESS_SITEMAP_URL=
WORDPRESS_FEED_URL=
WORDPRESS_SITE_NAME=The Screen / Cinerie
PUBLISHER_NAME=The Screen / Cinerie
PUBLISHER_DOMAIN=

## Forçar indexação de todos os posts (independente do score editorial)
FORCE_INDEX_ALL_POSTS=true

## AI Validator (segunda camada de IA)
AI_VALIDATOR_ENABLED=true
AI_VALIDATOR_MODEL=gemini-2.5-flash-lite
AI_VALIDATOR_MAX_RETRIES=1
AI_VALIDATOR_FAIL_OPEN=true

## Google Indexing API
GOOGLE_INDEXING_ENABLED=false
GOOGLE_INDEXING_CREDENTIALS_FILE=
GOOGLE_URL_INSPECTION_ENABLED=false
GSC_PROPERTY=
GOOGLE_URL_INSPECTION_SITE_URL=
GOOGLE_URL_INSPECTION_LANGUAGE_CODE=pt-BR
GOOGLE_URL_INSPECTION_ENDPOINT=https://searchconsole.googleapis.com/v1/urlInspection/index:inspect

## IndexNow
INDEXNOW_ENABLED=false
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

## Dashboard authentication
DASHBOARD_TOKEN=troque-por-um-token-seguro

## Yoast News Sitemap
YOAST_NEWS_SITEMAP_ENABLED=false
YOAST_NEWS_SITEMAP_URL=
YOAST_NEWS_SITEMAP_VALIDATE_RECENT_POSTS=false
YOAST_NEWS_SITEMAP_TIMEOUT=20

## Recrawl controlado
RECRAWL_ENABLED=false
RECRAWL_DELAY_MINUTES=15
RECRAWL_MAX_ATTEMPTS=3
RECRAWL_INCLUDE_INITIAL_PUBLISH=true

## Discovery seguro
DISCOVERY_RELATED_LINKS_ENABLED=false
DISCOVERY_RELATED_LINKS_LIMIT=5

## Sitemap ping
SITEMAP_PING_ENABLED=true
SITEMAP_PING_ENDPOINTS=google_sitemap=https://www.google.com/ping?sitemap={sitemap};bing_sitemap=https://www.bing.com/ping?sitemap={sitemap}

## RSS ping
RSS_PING_ENABLED=true
RSS_PING_XMLRPC_URL=https://rpc.pingomatic.com/

## Pipeline
IMAGES_MODE=hotlink
PUBLISHER_LOGO_URL=
MAX_PER_FEED_CYCLE=3
MAX_PER_CYCLE=10
ARTICLE_SLEEP_S=120
BETWEEN_BATCH_DELAY_S=30
BETWEEN_PUBLISH_DELAY_S=30
FEED_STAGGER_S=45
DEFAULT_FEATURED_MEDIA_ID=
DEFAULT_FEATURED_IMAGE_SEARCH=

## AI backoff / rate limits
AI_MIN_INTERVAL_S=6
BACKOFF_BASE_S=20
BACKOFF_MAX_S=300

## TMDB (optional)
TMDB_ENABLED=false
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_MAX_ENRICHMENTS=3
TMDB_EXTRACT_TRENDING=false
TMDB_EXTRACT_UPCOMING=false
