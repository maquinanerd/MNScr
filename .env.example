## ---------------------------------------------------------------------------
## MNScr — motor editorial de drafts
## MNScr NÃO publica, NÃO aprova e NÃO indexa. Ele gera drafts estruturados.
## ---------------------------------------------------------------------------

## Saída editorial
# Modos aceitos: local | payload
# "wordpress" é rejeitado no startup.
MNSCR_OUTPUT_MODE=local
MNSCR_LOCAL_DRAFT_DIR=artifacts/local-drafts

## Payload CMS (Cinerie) — integração ainda bloqueada pelo contrato editorial
PAYLOAD_ENABLED=false
PAYLOAD_BASE_URL=
PAYLOAD_API_TOKEN=
PAYLOAD_DRAFTS_COLLECTION=editorial-drafts

## Identidade editorial
PUBLISHER_NAME=Cinerie
# Domínio usado apenas para sugerir links internos no corpo do draft.
PUBLISHER_DOMAIN=
MNSCR_USER_AGENT=MNScr/1.0 (+editorial draft pipeline)
MNSCR_PROMPT_VERSION=universal_prompt-ms1

## Gemini API keys (uma ou mais). Valores devem começar com AIza...
GEMINI_KEY_1=
GEMINI_KEY_2=

## Seleção de modelo
GEMINI_MODEL_ID=gemini-3.1-flash-lite
AI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
AI_MAX_RETRIES=8

## AI Validator (segunda camada de IA)
AI_VALIDATOR_ENABLED=true
AI_VALIDATOR_MODEL=gemini-2.5-flash-lite
AI_VALIDATOR_MAX_RETRIES=1
AI_VALIDATOR_FAIL_OPEN=true

## Orçamento de tokens por artigo
AI_POST_WRITER_BUDGET_TOKENS=16000
AI_POST_WRITER_BUDGET_PER_1K_SOURCE=6000

## AI backoff / rate limits
AI_MIN_INTERVAL_S=6
BACKOFF_BASE_S=20
BACKOFF_MAX_S=300

## Agendador / pipeline
CHECK_INTERVAL_MINUTES=15
MAX_PER_FEED_CYCLE=3
MAX_PER_CYCLE=10
ARTICLE_SLEEP_S=120
BETWEEN_BATCH_DELAY_S=30
BETWEEN_PUBLISH_DELAY_S=30
FEED_STAGGER_S=45
ARTICLE_WATCHDOG_TIMEOUT_S=300
MAX_ARTICLE_FAIL_COUNT=5

## Política de fonte
# true permite gerar draft a partir de uma única fonte não-allowlisted.
ALLOW_SINGLE_SOURCE=false
